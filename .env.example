APP_NAME="Keel App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://keel.local
APP_REPO_URL=
APP_LICENSE=TODO
MULTI_TENANCY_ENABLED=true
FILESYSTEM_DISK=local
FILESYSTEM_MAX_UPLOAD_MB=10
FILESYSTEM_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keel
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Keel App"

# Score feed for football squares. Scores come from ESPN's public scoreboard;
# no key is needed. ESPN's edge rejects unrecognised user agents, so override
# this if they tighten the rule (see EspnScoreProvider).
SCORES_FEED_USER_AGENT=

# Plivo SMS for winner notifications. Blank disables SMS; email still sends.
# PLIVO_SRC_NUMBER must be an E.164 number on the account.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SRC_NUMBER=
# Defaults to APP_URL + /webhooks/plivo/status when blank.
PLIVO_STATUS_CALLBACK_URL=
# Country code assumed for claim-form numbers with no international prefix.
SMS_DEFAULT_COUNTRY_CODE=1

# Where demo requests from the marketing site are emailed.
# Falls back to MAIL_FROM_ADDRESS when blank.
LEAD_NOTIFICATION_EMAIL=
