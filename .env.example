# DealerDraw environment.
#
# Copy to .env and edit. Keys marked REQUIRED must be set before the app boots;
# everything else has a working default or degrades cleanly.
#
# Never commit a real credential, a real phone number, or a dealer's data.

# ---------------------------------------------------------------- app --------

APP_NAME="DealerDraw"
# local | production. production disables debug output and blocks the demo seeder.
APP_ENV=local
APP_DEBUG=true
# REQUIRED. Absolute base URL, no trailing slash. Used for canonical tags,
# sitemap URLs, the Plivo status callback, and Plivo signature verification -
# a wrong value here silently breaks the webhooks.
APP_URL=http://dealerdraw.local
APP_REPO_URL=
APP_LICENSE=proprietary

# Must stay true. Every dealer is an organization row and all admin queries are
# tenant-scoped; turning this off leaves users with no tenant.
MULTI_TENANCY_ENABLED=true

# --------------------------------------------------------------- database ----

# All REQUIRED. The database is created for you by database/migrate.php if the
# user has permission.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dealerdraw
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------ auth -----

# otp | magic_link | both. Dealer admin sign-in; there are no passwords.
AUTH_METHOD=both

# ------------------------------------------------------------------ mail -----

# log | smtp.
#   log  - writes messages to storage/logs/mail.log. Use this locally: sign-in
#          codes and winner emails land in that file with no SMTP account.
#   smtp - real delivery. Required in production.
MAIL_MAILER=log

# REQUIRED when MAIL_MAILER=smtp.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="DealerDraw"

# Where marketing-site demo requests are emailed. Falls back to MAIL_FROM_ADDRESS.
LEAD_NOTIFICATION_EMAIL=

# ----------------------------------------------------------------- scores ----

# Scores come from ESPN's public scoreboard. There is no API key and no toggle:
# the provider is chosen in ScoreSyncService::provider(). A game with no
# external_id is scored by hand instead and is never polled.
#
# ESPN's edge rejects unrecognised user agents with a 403. Leave blank to use the
# built-in default; set it only if they tighten that rule. See EspnScoreProvider.
SCORES_FEED_USER_AGENT=

# -------------------------------------------------------------------- sms ----

# Plivo. Leave all three blank locally - SMS is skipped and email still sends.
# REQUIRED in production, along with completed 10DLC registration.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The sending number, in E.164, e.g. +15555550100. Must belong to the account.
PLIVO_SRC_NUMBER=
# Where Plivo posts delivery status. Blank means APP_URL + /webhooks/plivo/status.
PLIVO_STATUS_CALLBACK_URL=
# Country code assumed for claim-form numbers typed without a prefix.
SMS_DEFAULT_COUNTRY_CODE=1

# ------------------------------------------------------------------ files ----

FILESYSTEM_DISK=local
FILESYSTEM_MAX_UPLOAD_MB=10
FILESYSTEM_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic

# ------------------------------------------------- inherited from Keel --------
# Not used by DealerDraw. Left in place because Keel's controllers read them.

# Billing is not part of this build; dealers are invoiced manually.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
